@using MyProject.Models
@model TvShow[]

<div class ="row row-cols-md-2 g-3">
    @foreach(var show in Model)
    {
        <div class="col">
            <div class="card bg-secondary-subtle mb-3 card-hoverable">
                <div class="row g-0">
                    <div class= "col-md-4">
                        <img src="@show.Image?.Medium" class="search-card-img"/>
                    </div>
                    <div class="col-md-8">
                        <div class="card-body">
                            <div class="card-header bg-body-primary">
                                <h5 class="card-title text-truncate">@show.Name</h5>
                            </div>
                            <div class="card-body search-card-summary-body bg-body-tertiary">
                                <div class ="card-text clamped-summary" style="--clamp-lines: 7;">
                                    @Html.Raw(show.Summary)
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <a class="stretched-link" asp-controller="Shows" asp-action="Details" asp-route-id="@show.Id"></a>
            </div>
        </div>
    }
</div>