@using MyProject.Areas.Identity.Data
@using MyProject.Models.UserShow
@using MyProject.ViewModels
@model ShowDetailsViewModel
@inject Microsoft.AspNetCore.Identity.SignInManager<ApplicationUser> SignInManager;

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-3 text-center">
            <div class="card bg-dark">
                <img src="@Model.Show.Image?.Original"/>
            </div>
            <div class="mt-2">
                @foreach (var genre in Model.Show.Genres) {
                    <span class="badge text-bg-secondary">@genre</span>
                }
            </div>
            @if(Model.ShowStatus == ShowStatus.Watched) 
            {
                <form asp-controller="Shows" asp-action="ShowEntryDelete" method="post">
                    <input type="hidden" name="tvMazeShowId" value="@Model.Show.Id" />
                    <button type ="submit" class="btn icon-btn shadow-none border-0">
                        <i class="bi bi-eye-fill icon-xl"></i>
                        <div class="small">Watched</div>
                    </button>
                </form>
            }
            else
            {
                <form asp-controller="Shows" asp-action="UpdateStatus" method="post">
                    <input type="hidden" name="tvMazeShowId" value="@Model.Show.Id" />
                    <input type="hidden" name="showStatus" value="Watched" />
                    <button type ="submit" class="btn icon-btn shadow-none border-0">
                        <i class="bi bi-eye icon-xl"></i>
                        <div class="small">Watch</div>
                    </button>
                </form>
            }
        </div>
        <div class="col-md-5">
            <div class="card bg-dark text-white">
                <div class = "card-body">
                    <h1 class="card-title border-bottom border-light pb-2">@Model.Show.Name</h1>
                    @Html.Raw(Model.Show.Summary)
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item list-group-item-dark">Language: @Model.Show.Language</li>
                    <li class="list-group-item list-group-item-dark">Status: @Model.Show.Status</li>
                    <li class="list-group-item list-group-item-dark">Premiered: @Model.Show.Premiered</li>
                    <li class="list-group-item list-group-item-dark">Ended: @(Model.Show.Ended.ToString() ?? "Still Airing")</li>
                    <li class="list-group-item list-group-item-dark">Average Rating: @Model.Show.Rating?.Average?.ToString().Replace(",", ".")</li>
                </ul>
            </div>
            <div class="d-flex w-100">
                <form asp-controller="Shows" asp-action="@(Model.ShowStatus == ShowStatus.Watchlist ? "ShowEntryDelete" : "UpdateStatus")" method="post" class="w-50">
                    <input type="hidden" name="tvMazeShowId" value="@Model.Show.Id"/>
                    @if (Model.ShowStatus != ShowStatus.Watchlist)
                    {
                        <input type="hidden" name="showStatus" value="Watchlist"/>
                    }
                    <button type="submit" class="w-100 btn btn-lg btn-primary mt-2">
                        @(Model.ShowStatus == ShowStatus.Watchlist ? "Remove From Watchlist" : "Add To Watchlist")
                    </button>
                </form>
                <a asp-controller="Shows" asp-action="Episodes" asp-route-id="@Model.Show.Id" class="flex-grow-1">
                    <button type="button" class="w-100 btn btn-lg btn-primary mt-2">View Episodes</button>
                </a>
            </div>
        </div>
    </div>
</div>